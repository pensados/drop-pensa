# Test image: same as runtime but with dev deps installed.
FROM python:3.12-slim

WORKDIR /app

# libmagic for python-magic (same as prod image).
RUN apt-get update && apt-get install -y --no-install-recommends libmagic1 curl \
    && rm -rf /var/lib/apt/lists/*

# uv for fast installs.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

COPY pyproject.toml /app/
RUN uv venv /app/.venv && uv pip install --quiet ".[dev]"

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app/src

COPY src /app/src
COPY tests /app/tests

# CLEANUP_ENABLED=false avoids spawning the worker during tests (the
# fixture also sets this, but a redundant env var keeps things obvious).
ENV CLEANUP_ENABLED=false

CMD ["pytest", "-v", "--tb=short", "/app/tests"]
