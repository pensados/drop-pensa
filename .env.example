# drop-pensa configuration
# Copy to .env and adjust as needed

# Service
DEBUG=false

# Storage
STORAGE_DIR=/var/lib/drop-pensa/files
DB_URL=sqlite:////var/lib/drop-pensa/drop.db

# File limits (50 MB default)
MAX_FILE_SIZE_MB=50

# TTL in seconds
DEFAULT_TTL_SECONDS=3600
MAX_TTL_SECONDS=604800

# Blocked extensions (comma-separated, case-insensitive)
BLOCKED_EXTENSIONS=exe,bat,cmd,scr,msi,dll,com,js,vbs,jar,apk

# Cleanup worker
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=300

# Optional Redis (for rate limiting and caching)
# Leave unset to use in-memory fallback
REDIS_URL=redis://redis:6379
